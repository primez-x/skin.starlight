<?xml version="1.0" encoding="UTF-8"?>
<includes>
  <include name="DialogDim">
    <param name="soft" default="false" />
    <definition>
      <control type="image">
        <left>0</left>
        <top>0</top>
        <width>1920</width>
        <height>1080</height>
        <visible>!$PARAM[soft]</visible>
        <texture>dim_modal.png</texture>
      </control>
      <control type="image">
        <left>0</left>
        <top>0</top>
        <width>1920</width>
        <height>1080</height>
        <visible>$PARAM[soft]</visible>
        <texture>dim_soft.png</texture>
      </control>
    </definition>
  </include>
  <include name="DialogSheet">
    <param name="width" default="800" />
    <param name="height" default="540" />
    <definition>
      <include content="GlassPanel">
        <param name="width" value="$PARAM[width]" />
        <param name="height" value="$PARAM[height]" />
      </include>
    </definition>
  </include>
  <include name="DialogButton">
    <param name="id" default="0" />
    <param name="label" default="" />
    <param name="width" default="224" />
    <param name="height" default="64" />
    <param name="onclick" default="" />
    <param name="color" default="frost" />
    <definition>
      <control type="button" id="$PARAM[id]">
        <left>0</left>
        <top>0</top>
        <width>$PARAM[width]</width>
        <height>$PARAM[height]</height>
        <label>$PARAM[label]</label>
        <onclick>$PARAM[onclick]</onclick>
        <textcolor>$PARAM[color]</textcolor>
        <focusedcolor>$PARAM[color]</focusedcolor>
        <texturenofocus border="capsule_border">glass_capsule.png</texturenofocus>
      </control>
    </definition>
  </include>
  <include name="DialogListLayout">
    <param name="selected" default="false" />
    <param name="width" default="688" />
    <param name="detailed" default="false" />
    <definition>
      <control type="group">
        <left>0</left>
        <top>0</top>
        <width>$PARAM[width]</width>
        <height>64</height>
        <control type="image">
          <left>-48</left>
          <top>-48</top>
          <right>-48</right>
          <height>160</height>
          <visible>$PARAM[selected]</visible>
          <texture border="focus_glow_border">focus_glow.png</texture>
        </control>
        <control type="image">
          <left>0</left>
          <top>0</top>
          <width>$PARAM[width]</width>
          <height>64</height>
          <visible>$PARAM[selected]</visible>
          <texture border="focus_border">focus_button.png</texture>
        </control>
        <control type="image">
          <left>16</left>
          <top>8</top>
          <width>48</width>
          <height>48</height>
          <aspectratio>keep</aspectratio>
          <visible>$PARAM[detailed]</visible>
          <texture>$INFO[ListItem.Icon]</texture>
        </control>
        <control type="label">
          <left>24</left>
          <top>0</top>
          <width>620</width>
          <height>64</height>
          <label>$INFO[ListItem.Label]</label>
          <font>font_label_large</font>
          <visible>!$PARAM[detailed]</visible>
        </control>
        <control type="label">
          <left>80</left>
          <top>0</top>
          <width>560</width>
          <height>36</height>
          <label>$INFO[ListItem.Label]</label>
          <font>font_label_large</font>
          <visible>$PARAM[detailed]</visible>
        </control>
        <control type="label">
          <left>80</left>
          <top>34</top>
          <width>560</width>
          <height>26</height>
          <label>$INFO[ListItem.Label2]</label>
          <font>font_label_small</font>
          <textcolor>mist</textcolor>
          <visible>$PARAM[detailed]</visible>
        </control>
        <control type="image">
          <left>$PARAM[check_x]</left>
          <top>20</top>
          <width>24</width>
          <height>24</height>
          <visible>ListItem.IsSelected</visible>
          <texture>icons/check.png</texture>
        </control>
      </control>
    </definition>
    <param name="check_x" default="640" />
  </include>
  <include name="StatusSlot">
    <param name="volume" default="false" />
    <param name="toast" default="false" />
    <param name="background" default="false" />
    <definition>
      <animation effect="slide" start="0,0" end="0,196" time="180" condition="Skin.String(Hub.Navigation,top_centre) | Skin.String(Hub.Navigation,top_left)">Conditional</animation>
      <animation effect="slide" start="0,0" end="0,88" time="180" condition="!$PARAM[volume] + Window.IsVisible(volumebar)">Conditional</animation>
      <animation effect="slide" start="0,0" end="0,104" time="180" condition="!$PARAM[volume] + !$PARAM[toast] + Window.IsVisible(notification)">Conditional</animation>
      <animation effect="slide" start="0,0" end="0,116" time="180" condition="!$PARAM[volume] + !$PARAM[toast] + !$PARAM[background] + Window.IsVisible(extendedprogressdialog)">Conditional</animation>
    </definition>
  </include>
