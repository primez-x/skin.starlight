  <include name="MiniHorizon">
    <param name="x" default="14" />
    <param name="y" default="0" />
    <param name="size" default="80" />
    <definition>
      <control type="group">
        <left>$PARAM[x]</left>
        <top>$PARAM[y]</top>
        <width>$PARAM[size]</width>
        <height>$PARAM[size]</height>
        <control type="image">
          <left>0</left>
          <top>0</top>
          <width>$PARAM[size]</width>
          <height>$PARAM[size]</height>
          <texture>busy_horizon.png</texture>
        </control>
        <control type="group">
          <width>80</width>
          <height>80</height>
          <animation effect="rotate" start="0" end="360" center="40,40" time="1000" loop="true" condition="true">Conditional</animation>
          <control type="image">
            <left>32</left>
            <top>2</top>
            <width>16</width>
            <height>16</height>
            <texture>star_soft.png</texture>
          </control>
        </control>
      </control>
    </definition>
  </include>
  <include name="BusyPill">
    <definition>
      <control type="group">
        <left>810</left>
        <top>40</top>
        <width>300</width>
        <height>80</height>
        <include content="StatusSlot" />
        <include content="BusyStars" />
        <control type="image">
          <left>0</left>
          <top>0</top>
          <width>300</width>
          <height>80</height>
          <texture border="capsule_border">glass_capsule.png</texture>
        </control>
        <include content="MiniHorizon" />
        <control type="label">
          <left>104</left>
          <top>0</top>
          <width>170</width>
          <height>80</height>
          <label>$LOCALIZE[31055]</label>
          <font>font_label_large</font>
        </control>
        <include content="BusyStars">
          <param name="front" value="true" />
        </include>
      </control>
    </definition>
  </include>
  <include name="KeyboardKey">
    <param name="id" default="100" />
    <param name="x" default="0" />
    <param name="y" default="0" />
    <param name="width" default="142" />
    <param name="label" default="" />
    <param name="left" default="100" />
    <param name="right" default="100" />
    <param name="up" default="312" />
    <param name="down" default="300" />
    <param name="done" default="false" />
    <definition>
      <control type="group">
        <left>$PARAM[x]</left>
        <top>$PARAM[y]</top>
        <width>$PARAM[width]</width>
        <height>66</height>
        <control type="image">
          <left>0</left>
          <top>0</top>
          <width>$PARAM[width]</width>
          <height>66</height>
          <texture border="panel_border">glass_panel.png</texture>
        </control>
        <control type="image">
          <left>-48</left>
          <top>-48</top>
          <right>-48</right>
          <height>162</height>
          <visible>Control.HasFocus($PARAM[id])</visible>
          <texture border="focus_glow_border">focus_glow.png</texture>
        </control>
        <control type="image">
          <left>0</left>
          <top>0</top>
          <width>$PARAM[width]</width>
          <height>66</height>
          <visible>$PARAM[done]</visible>
          <texture border="panel_border">keyboard_done.png</texture>
        </control>
        <control type="button" id="$PARAM[id]">
          <left>0</left>
          <top>0</top>
          <width>$PARAM[width]</width>
          <height>66</height>
          <label>$PARAM[label]</label>
          <font>font_heading_small</font>
          <onleft>$PARAM[left]</onleft>
          <onright>$PARAM[right]</onright>
          <onup>$PARAM[up]</onup>
          <ondown>$PARAM[down]</ondown>
          <textcolor>$PARAM[color]</textcolor>
          <focusedcolor>$PARAM[color]</focusedcolor>
          <texturefocus border="card_border">focus_card.png</texturefocus>
          <texturenofocus />
        </control>
        <visible>!String.IsEmpty(Control.GetLabel($PARAM[id]))</visible>
      </control>
    </definition>
    <param name="color" default="frost" />
  </include>
  <variable name="ConfirmYesColor">
    <value condition="String.IsEqual(Window(home).Property(Starlight.Confirm.Destructive),true) | String.IsEqual(Control.GetLabel(11),$LOCALIZE[117]) | String.IsEqual(Control.GetLabel(11),Remove)">danger</value>
    <value>frost</value>
  </variable>
  <include name="DialogScrollbar">
    <param name="id" default="60" />
    <param name="x" default="1120" />
    <param name="y" default="110" />
    <param name="height" default="550" />
    <param name="return" default="10" />
    <definition>
      <control type="scrollbar" id="$PARAM[id]">
        <left>$PARAM[x]</left>
        <top>$PARAM[y]</top>
        <width>8</width>
        <height>$PARAM[height]</height>
        <orientation>vertical</orientation>
        <showonepage>false</showonepage>
        <onup>$PARAM[id]</onup>
        <ondown>$PARAM[id]</ondown>
        <onright>$PARAM[return]</onright>
        <onleft>$PARAM[return]</onleft>
        <texturesliderbackground border="progress_border">progress_track.png</texturesliderbackground>
        <texturesliderbar border="progress_border">progress_frost.png</texturesliderbar>
        <texturesliderbarfocus border="progress_border">progress_gold.png</texturesliderbarfocus>
        <textureslidernib />
        <textureslidernibfocus />
      </control>
    </definition>
  </include>
  <variable name="SelectList">
    <value condition="Control.IsVisible(6)">6</value>
    <value>3</value>
  </variable>
</includes>
