<?xml version="1.0" encoding="UTF-8"?>
<window>
  <defaultcontrol always="true">510</defaultcontrol>
  <onload>SetProperty(Starlight.Hub,home,home)</onload>
  <onload>SetProperty(Starlight.Container,510,home)</onload>
  <onload>ClearProperty(Starlight.Source.continue,home)</onload>
  <onload>ClearProperty(Starlight.Source.next,home)</onload>
  <onload>ClearProperty(Starlight.Source.movies,home)</onload>
  <onload>ClearProperty(Starlight.Source.episodes,home)</onload>
  <controls>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <texture>background_void.png</texture>
    </control>
    <control type="image">
      <left>-192</left>
      <top>-108</top>
      <width>2304</width>
      <height>1296</height>
      <colordiffuse>FF616161</colordiffuse>
      <fadetime>400</fadetime>
      <texture>$VAR[HomeBlurred]</texture>
    </control>
    <control type="image">
      <left>420</left>
      <top>0</top>
      <width>1500</width>
      <height>900</height>
      <aspectratio>scale</aspectratio>
      <fadetime>400</fadetime>
      <texture diffuse="art_falloff.png">$VAR[HomeFanart]</texture>
      <visible>Skin.String(Home.Art.Mode,bound)</visible>
    </control>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <texture>home_shade.png</texture>
    </control>
    <control type="image">
      <left>155</left>
      <top>820</top>
      <width>12</width>
      <height>12</height>
      <colordiffuse>33FFFFFF</colordiffuse>
      <texture>star_twinkle.png</texture>
      <visible>!Skin.HasSetting(AmbientEffects.Disabled)</visible>
      <animation effect="fade" start="8" end="30" time="3600" delay="0" pulse="true" loop="true" condition="true">Conditional</animation>
    </control>
    <control type="image">
      <left>168</left>
      <top>895</top>
      <width>12</width>
      <height>12</height>
      <colordiffuse>33FFFFFF</colordiffuse>
      <texture>star_twinkle.png</texture>
      <visible>!Skin.HasSetting(AmbientEffects.Disabled)</visible>
      <animation effect="fade" start="8" end="30" time="3600" delay="1700" pulse="true" loop="true" condition="true">Conditional</animation>
    </control>
    <control type="image">
      <left>148</left>
      <top>970</top>
      <width>12</width>
      <height>12</height>
      <colordiffuse>33FFFFFF</colordiffuse>
      <texture>star_twinkle.png</texture>
      <visible>!Skin.HasSetting(AmbientEffects.Disabled)</visible>
      <animation effect="fade" start="8" end="30" time="3600" delay="3200" pulse="true" loop="true" condition="true">Conditional</animation>
    </control>
    <control type="group">
      <left>196</left>
      <top>0</top>
      <width>1644</width>
      <height>1080</height>
      <animation effect="slide" start="0,0" end="204,0" time="220" condition="ControlGroup(9000).HasFocus + !Skin.String(Hub.Navigation,icons) + !Skin.String(Hub.Navigation,top_left) + !Skin.String(Hub.Navigation,top_centre)">Conditional</animation>
      <animation effect="slide" start="0,0" end="-116,0" time="220" condition="Skin.String(Hub.Navigation,top_left) | Skin.String(Hub.Navigation,top_centre)">Conditional</animation>
      <control type="label">
        <left>0</left>
        <top>50</top>
        <width>1200</width>
        <height>64</height>
        <label>$VAR[HomeGreeting]</label>
        <font>font_hub_title</font>
      </control>
      <control type="grouplist" id="5000">
        <left>-48</left>
        <top>210</top>
        <width>1740</width>
        <height>870</height>
        <orientation>vertical</orientation>
        <itemgap>0</itemgap>
        <scrolltime>260</scrolltime>
        <usecontrolcoords>true</usecontrolcoords>
        <onleft>9000</onleft>
        <onup>9000</onup>
        <ondown>9000</ondown>
        <include content="HomeWidget">
          <param name="source" value="continue" />
          <param name="setting" value="Home.Continue.Layout" />
          <param name="default_board" value="true" />
          <param name="default_landscape" value="false" />
          <param name="label" value="$LOCALIZE[31011]" />
          <param name="group" value="1510" />
          <param name="feature" value="510" />
          <param name="tiles" value="511" />
          <param name="row" value="512" />
          <param name="empty" value="513" />
          <param name="up" value="9000" />
          <param name="down" value="1520" />
        </include>
        <include content="HomeWidget">
          <param name="source" value="movies" />
          <param name="setting" value="Home.Movies.Layout" />
          <param name="default_poster" value="true" />
          <param name="default_landscape" value="false" />
          <param name="label" value="$LOCALIZE[31012]" />
          <param name="group" value="1520" />
          <param name="feature" value="520" />
          <param name="tiles" value="521" />
          <param name="row" value="522" />
          <param name="empty" value="523" />
          <param name="up" value="1510" />
          <param name="down" value="1530" />
        </include>
        <include content="HomeWidget">
          <param name="source" value="next" />
          <param name="setting" value="Home.Next.Layout" />
          <param name="default_landscape" value="true" />
          <param name="label" value="$LOCALIZE[31013]" />
          <param name="group" value="1530" />
          <param name="feature" value="530" />
          <param name="tiles" value="531" />
          <param name="row" value="532" />
          <param name="empty" value="533" />
          <param name="up" value="1520" />
          <param name="down" value="1540" />
        </include>
        <include content="HomeWidget">
          <param name="source" value="episodes" />
          <param name="setting" value="Home.Episodes.Layout" />
          <param name="default_landscape" value="true" />
          <param name="label" value="$LOCALIZE[31014]" />
          <param name="group" value="1540" />
          <param name="feature" value="540" />
          <param name="tiles" value="541" />
          <param name="row" value="542" />
          <param name="empty" value="543" />
          <param name="up" value="1530" />
          <param name="down" value="1550" />
        </include>
        <include content="LiveTVHomeWidget" />
        <pagecontrol>5500</pagecontrol>
      </control>
    </control>
    <control type="label">
      <left>1500</left>
      <top>58</top>
      <width>340</width>
      <height>46</height>
      <label>$INFO[System.Time]</label>
      <font>font_clock</font>
      <align>right</align>
      <shadowcolor>FF03050A</shadowcolor>
    </control>
    <control type="label">
      <left>1450</left>
      <top>106</top>
      <width>390</width>
      <height>30</height>
      <label>$INFO[Weather.Temperature] $INFO[Weather.Conditions]</label>
      <font>font_label</font>
      <align>right</align>
      <textcolor>mist</textcolor>
      <shadowcolor>FF03050A</shadowcolor>
      <visible>!String.IsEmpty(Weather.Temperature)</visible>
    </control>
    <include content="HubRail">
      <param name="return" value="5000" />
    </include>
    <control type="scrollbar" id="5500">
      <left>0</left>
      <top>0</top>
      <width>1</width>
      <height>1</height>
      <visible>false</visible>
      <orientation>vertical</orientation>
    </control>
    <control type="button" id="5501">
      <left>0</left>
      <top>0</top>
      <width>1</width>
      <height>1</height>
      <visible>false</visible>
      <label>$INFO[Control.GetLabel(5500)]</label>
    </control>
    <control type="button" id="5502">
      <left>0</left>
      <top>0</top>
      <width>1</width>
      <height>1</height>
      <visible>false</visible>
      <label>$VAR[HomeContextPosition]</label>
    </control>
  </controls>
</window>
