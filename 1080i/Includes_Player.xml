<includes>
  <variable name="PlayerAlbum">
    <value condition="!String.IsEmpty(MusicPlayer.Cover)">$INFO[MusicPlayer.Cover]</value>
    <value>player/album_placeholder.png</value>
  </variable>
  <variable name="PlayerPlayIcon">
    <value condition="Player.Paused">icons/play.png</value>
    <value>player/pause.png</value>
  </variable>
  <variable name="PlayerPlayLabel">
    <value condition="Player.Paused">$LOCALIZE[31201]</value>
    <value>$LOCALIZE[31202]</value>
  </variable>
  <variable name="PlayerShuffleColor">
    <value condition="Playlist.IsRandom">gold</value>
    <value>frost</value>
  </variable>
  <variable name="PlayerRepeatColor">
    <value condition="Playlist.IsRepeat | Playlist.IsRepeatOne">gold</value>
    <value>frost</value>
  </variable>
  <variable name="PlayerRepeatIcon">
    <value condition="Playlist.IsRepeatOne">player/repeat_one.png</value>
    <value>player/repeat.png</value>
  </variable>
  <variable name="PlayerHeartIcon">
    <value condition="String.IsEqual(Window(home).Property(Spotify.CurrentTrackLiked),true)">player/heart_filled.png</value>
    <value>player/heart.png</value>
  </variable>
  <variable name="PlayerHeartColor">
    <value condition="String.IsEqual(Window(home).Property(Spotify.CurrentTrackLiked),true)">gold</value>
    <value>frost</value>
  </variable>
  <variable name="PlayerCountdown">
    <value condition="Integer.IsLess(Window(home).Property(Starlight.NextTrack.Remaining),10)">0:0$INFO[Window(home).Property(Starlight.NextTrack.Remaining)]</value>
    <value>0:$INFO[Window(home).Property(Starlight.NextTrack.Remaining)]</value>
  </variable>
  <variable name="PlayerNextArt">
    <value condition="!String.IsEmpty(Window(home).Property(Starlight.NextTrack.Art))">$INFO[Window(home).Property(Starlight.NextTrack.Art)]</value>
    <value>player/album_placeholder.png</value>
  </variable>
  <variable name="PlayerQueueEmpty">
    <value condition="String.IsEqual(Window.Property(Starlight.Queue.Error),true)">$LOCALIZE[31219]</value>
    <value>$LOCALIZE[31217]</value>
  </variable>
  <variable name="PlayerVideoLogo">
    <value condition="!String.IsEmpty(Player.Art(clearlogo))">$INFO[Player.Art(clearlogo)]</value>
    <value>$INFO[Player.Art(tvshow.clearlogo)]</value>
  </variable>
  <variable name="PlayerVideoTitle">
    <value condition="!String.IsEmpty(VideoPlayer.TVShowTitle)">$INFO[VideoPlayer.TVShowTitle]$INFO[VideoPlayer.Title, · ,]</value>
    <value>$INFO[VideoPlayer.Title]</value>
  </variable>
  <variable name="PlayerTime">
    <value condition="Player.Seeking">$INFO[Player.SeekTime]</value>
    <value>$INFO[Player.Time]</value>
  </variable>
  <variable name="PlayerMusicDetail">
    <value condition="!String.IsEmpty(MusicPlayer.Artist)">$INFO[MusicPlayer.Artist]$INFO[MusicPlayer.Album, · ,]</value>
    <value>$INFO[MusicPlayer.Album]</value>
  </variable>
  <variable name="PlayerVideoEdition">
    <value condition="Integer.IsGreater(VideoPlayer.Year,0)">$INFO[VideoPlayer.Year]$INFO[VideoPlayer.VideoVersionName, · ,]</value>
    <value>$INFO[VideoPlayer.VideoVersionName]</value>
  </variable>
  <variable name="PlayerVideoPeople">
    <value condition="!String.IsEmpty(VideoPlayer.Genre)">$INFO[VideoPlayer.Genre]$INFO[VideoPlayer.Director, · ,]</value>
    <value>$INFO[VideoPlayer.Director]</value>
