  <include name="InfoContentMotion">
    <definition>
      <animation effect="slide" start="0,0" end="204,0" time="220" condition="ControlGroup(9000).HasFocus + !Skin.String(Hub.Navigation,icons) + !Skin.String(Hub.Navigation,top_left) + !Skin.String(Hub.Navigation,top_centre)">Conditional</animation>
      <animation effect="slide" start="0,0" end="0,120" time="220" condition="Skin.String(Hub.Navigation,top_left) | Skin.String(Hub.Navigation,top_centre)">Conditional</animation>
      <animation effect="zoom" start="100" end="86" center="0,0" time="220" condition="Skin.String(Hub.Navigation,top_left) | Skin.String(Hub.Navigation,top_centre)">Conditional</animation>
    </definition>
  </include>
  <include name="InfoClock">
    <definition>
      <control type="label">
        <left>1450</left>
        <top>48</top>
        <width>390</width>
        <height>60</height>
        <label>$INFO[System.Time]</label>
        <font>font_clock</font>
        <align>right</align>
        <shadowcolor>FF03050A</shadowcolor>
      </control>
      <control type="label">
        <left>1450</left>
        <top>106</top>
        <width>390</width>
        <height>30</height>
        <label>$INFO[Weather.Temperature] $INFO[Weather.Conditions]</label>
        <font>font_label</font>
        <align>right</align>
        <textcolor>mist</textcolor>
        <shadowcolor>FF03050A</shadowcolor>
        <visible>!String.IsEmpty(Weather.Temperature)</visible>
      </control>
    </definition>
  </include>
  <include name="EpisodeStatusCorner">
    <param name="feature" default="false" />
    <definition>
      <control type="group">
        <left>0</left>
        <top>0</top>
        <width>200</width>
        <height>70</height>
        <visible>String.IsEqual(ListItem.DBTYPE,episode) + [!$PARAM[feature] + [Integer.IsGreater(ListItem.PlayCount,0) | !String.IsEmpty(ListItem.Property(Starlight.Next))]]</visible>
        <control type="image">
          <left>0</left>
          <top>0</top>
          <width>200</width>
          <height>70</height>
          <texture>status_corner.png</texture>
        </control>
        <control type="image">
          <left>14</left>
          <top>12</top>
          <width>26</width>
          <height>26</height>
          <visible>Integer.IsGreater(ListItem.PlayCount,0)</visible>
          <texture>icons/check.png</texture>
        </control>
        <control type="label">
          <left>14</left>
          <top>10</top>
          <width>170</width>
          <height>30</height>
          <label>$LOCALIZE[31020]</label>
          <font>font_kicker</font>
          <textcolor>gold</textcolor>
          <visible>!Integer.IsGreater(ListItem.PlayCount,0) + !String.IsEmpty(ListItem.Property(Starlight.Next))</visible>
        </control>
      </control>
    </definition>
  </include>
  <include name="InfoAction">
    <param name="id" default="0" />
    <param name="icon" default="more" />
    <param name="label" default="" />
    <param name="width" default="64" />
    <param name="visible" default="true" />
    <param name="onclick" default="" />
    <param name="left" default="9000" />
    <param name="right" default="50" />
    <param name="down" default="250" />
    <param name="primary" default="false" />
    <definition>
      <control type="group">
        <left>0</left>
        <control type="image">
          <left>0</left>
          <top>0</top>
          <width>$PARAM[expanded]</width>
          <height>64</height>
          <visible>Control.HasFocus($PARAM[id])</visible>
          <texture border="focus_border">focus_button.png</texture>
        </control>
        <top>0</top>
        <width>$PARAM[width]</width>
        <height>64</height>
        <visible>$PARAM[visible]</visible>
        <control type="image">
          <left>-48</left>
          <top>-48</top>
          <width>$PARAM[expanded_glow]</width>
          <height>160</height>
          <visible>Control.HasFocus($PARAM[id])</visible>
          <texture border="focus_glow_border">focus_glow.png</texture>
        </control>
        <control type="image">
          <left>0</left>
          <top>0</top>
          <width>64</width>
          <height>64</height>
          <visible>ControlGroup(400).HasFocus + !Control.HasFocus($PARAM[id])</visible>
          <texture border="capsule_border">glass_capsule.png</texture>
        </control>
        <control type="image">
          <left>0</left>
          <top>0</top>
          <width>64</width>
          <height>64</height>
          <visible>!ControlGroup(400).HasFocus + $PARAM[primary]</visible>
          <texture border="capsule_border">frost_fill.png</texture>
        </control>
        <control type="button" id="$PARAM[id]">
          <left>0</left>
          <top>0</top>
          <width>$PARAM[expanded]</width>
          <height>64</height>
          <label>$PARAM[label]</label>
          <textcolor>transparent</textcolor>
          <focusedcolor>transparent</focusedcolor>
          <onclick>$PARAM[onclick]</onclick>
          <onleft>$PARAM[left]</onleft>
          <onright>$PARAM[right]</onright>
          <onup>9000</onup>
          <ondown>$PARAM[down]</ondown>
          <texturefocus border="focus_border" />
          <texturenofocus />
          <onclick>$PARAM[onclick2]</onclick>
        </control>
        <control type="image">
          <left>18</left>
          <top>18</top>
          <width>28</width>
          <height>28</height>
          <texture>icons/$PARAM[icon].png</texture>
        </control>
        <control type="label">
          <left>56</left>
          <top>0</top>
          <width>$PARAM[expanded_text]</width>
          <height>64</height>
          <label>$PARAM[label]</label>
          <font>font_label_large</font>
          <visible>$PARAM[primary] | Control.HasFocus($PARAM[id])</visible>
        </control>
        <animation effect="slide" start="0,0" end="160,0" time="180" condition="$PARAM[shift]">Conditional</animation>
        <animation effect="slide" start="0,0" end="256,0" time="180" condition="$PARAM[shift_wide]">Conditional</animation>
        <animation effect="slide" start="0,0" end="216,0" time="180" condition="$PARAM[shift_medium]">Conditional</animation>
      </control>
    </definition>
    <param name="shift" default="false" />
    <param name="onclick2" default="" />
    <param name="expanded" default="224" />
    <param name="expanded_text" default="158" />
    <param name="expanded_glow" default="320" />
    <param name="shift_wide" default="false" />
    <param name="shift_medium" default="false" />
  </include>
