<?xml version="1.0" encoding="UTF-8"?>
<window>
  <defaultcontrol always="true">0</defaultcontrol>
  <onload>AlarmClock(StarlightStartup,ReplaceWindow(Home),00:00:02,silent)</onload>
  <onunload>CancelAlarm(StarlightStartup,true)</onunload>
  <controls>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <texture>background_void.png</texture>
    </control>
    <control type="image">
      <left>480</left>
      <top>120</top>
      <width>960</width>
      <height>720</height>
      <texture>settings/splash_horizon.png</texture>
      <animation effect="zoom" start="86" end="100" center="960,480" time="500">WindowOpen</animation>
      <animation effect="fade" start="0" end="100" time="400">WindowOpen</animation>
    </control>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <texture>settings/splash_stars.png</texture>
      <animation effect="fade" start="0" end="100" delay="250" time="350">WindowOpen</animation>
    </control>
    <control type="image">
      <left>620</left>
      <top>760</top>
      <width>680</width>
      <height>80</height>
      <texture>settings/splash_wordmark.png</texture>
      <animation effect="fade" start="0" end="100" delay="500" time="250">WindowOpen</animation>
    </control>
  </controls>
  <animation effect="fade" start="100" end="0" time="150">WindowClose</animation>
</window>
